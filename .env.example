# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ------------------------------------------------------------
# Used directly by the backend when running outside Docker (e.g. `uvicorn
# app.main:app --reload` on your host). Inside docker-compose, the backend
# service overrides this to point at the "postgres" service instead.
DATABASE_URL=postgresql://revvy_user:revvy_password@localhost:5432/revvy

# Used by the postgres container itself (docker-compose.yml) and to build
# the docker-network DATABASE_URL above. Keep these in sync with the
# credentials embedded in DATABASE_URL if you change either.
POSTGRES_USER=revvy_user
POSTGRES_PASSWORD=revvy_password
POSTGRES_DB=revvy

# --- Auth (JWT) ------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI / LLM --------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Email service (password reset / notifications) ------------------------
EMAIL_SERVICE_API_KEY=your-email-service-api-key-here

# --- Frontend ---------------------------------------------------------------
# Baked into the Vite build at build time (compile-time env var, not runtime).
VITE_API_URL=http://localhost:8000

# --- Revit add-in / pyRevit extension ---------------------------------------
# Base URL the Revit add-in (pyRevit extension) uses to reach the backend.
REVVY_BACKEND_URL=http://localhost:8000
