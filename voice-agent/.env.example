# Reused from backend/.env -- same OpenAI account powers Whisper (STT), TTS,
# and the LangGraph agent's tool-calling model (gpt-4o).
OPENAI_API_KEY=sk-...

# Path to the RevitMCP.extension clone this agent spawns as an MCP server
# over stdio (same mechanism Claude Desktop's own config uses).
REVIT_MCP_PATH=C:\Users\Dhivyaa Premkumar\AppData\Roaming\pyRevit\Extensions\RevitMCP.extension\main.py
REVIT_MCP_UV_PATH=C:\Users\Dhivyaa Premkumar\.local\bin\uv.exe

# Wake word: one of openWakeWord's bundled models (see voice/wake_word.py).
# Options: alexa, hey_mycroft, hey_jarvis, hey_rhasspy, timer, weather.
WAKE_WORD_MODEL=hey_jarvis

# Realtime API model (streaming audio-to-audio with tool calling).
# gpt-realtime-mini is the cheaper/lower-latency tier -- switch to
# gpt-realtime only if you need noticeably better reasoning/voice quality.
AGENT_MODEL=gpt-realtime-mini

# Optional: your own REVVY account (same one you log into the web dashboard
# with) -- when set, every voice conversation is logged into REVVY's chat
# history so it shows up in the dashboard's Recent Activity / chat pages.
# Leave blank to skip this (the agent still works fully without it).
REVVY_BACKEND_URL=http://localhost:8000
REVVY_EMAIL=
REVVY_PASSWORD=

# The voice agent's window now shows the real web dashboard instead of the
# standalone orb.html -- point this at your frontend dev server (or, later,
# a production build's URL).
DASHBOARD_URL=http://localhost:5173
